{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substrate.local/frame-skin-manifest.schema.json",
  "title": "SUBSTRATE bundled frame skin",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "css", "supportedFrameTypes", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "css": { "const": "skin.css" },
    "supportedFrameTypes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["titleBar", "windowControls", "toolbarStyling", "decorativeEffects"],
      "properties": { "titleBar": { "type": "boolean" }, "windowControls": { "type": "boolean" }, "toolbarStyling": { "type": "boolean" }, "decorativeEffects": { "type": "boolean" } }
    }
  }
}
